{
  "version": 1,
  "root_dir": "/private/tmp/merman-fork",
  "include": [
    "**/*.rs",
    "**/*.go",
    "**/*.java"
  ],
  "exclude": [
    "target/**",
    ".git/**",
    ".codegraph/**",
    "node_modules/**",
    "vendor/**",
    "**/*.min.*",
    "bin/**",
    "build/**",
    "out/**",
    ".gradle/**"
  ],
  "max_file_size": 1048576,
  "extract_docstrings": true,
  "track_call_sites": true,
  "enable_embeddings": false
}